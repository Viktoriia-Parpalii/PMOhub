# Скопіюйте цей файл у .env.docker і заповніть реальними значеннями.
# Ніколи не додавайте .env.docker у Git.
#
# SQL Server на Docker-хості: host.docker.internal.
# SQL Server на іншому сервері: його приватне DNS-ім'я або IP-адреса.
DATABASE_URL="sqlserver://host.docker.internal:1433;database=pmohub;schema=dbo;user=pmohub_app;password=replace-me;encrypt=true;trustServerCertificate=true"

NODE_ENV=production
PORT=4000
HTTP_BODY_LIMIT=10mb
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
EXPOSE_ERROR_DETAILS=false
BUSINESS_TIME_ZONE=Europe/Kyiv
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Для production вкажіть справжню публічну HTTPS-адресу frontend.
# Для перевірки Docker локально використайте http://localhost:3000.
FRONTEND_ORIGIN=https://pmohub.example.com

# Порти, які будуть відкриті на Docker-хості.
FRONTEND_PORT=3000
API_PORT=4000

# Ці значення вбудовуються у frontend під час збирання образу.
# Nginx перенаправляє відносний /api/v1 до контейнера api.
VITE_API_URL=/api/v1
VITE_BASE_PATH=/

EXPORT_MAX_EXCEL_CARDS=20000
EXPORT_MAX_JSON_ROWS=100000
