  "info": {
    "title": "PMO Hub API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "current_password",
          "new_password"
        ]
      },
      "ApiSuccessDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true,
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string",
            "example": "Операцію виконано"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "success"
        ]
      },
      "PassportDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "strategic_goal": {
            "type": "string"
          },
          "manager_id": {
            "type": "string",
            "format": "uuid"
          },
          "priority": {
            "type": "string",
            "format": "uuid"
          },
          "notes": {
            "type": "string"
          },
          "implementer_dept_ids": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "cross_functional_dept_ids": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "custom_fields": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "name",
          "implementer_dept_ids",
          "cross_functional_dept_ids"
        ]
      },
      "ChecklistItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "is_completed": {
            "type": "boolean"
          },
          "color": {
            "type": "string"
          },
          "weightId": {
            "type": "string",
            "format": "uuid"
          },
          "weightSnapshot": {
            "type": "object",
            "properties": {
              "definitionId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "assigneeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "implementer_dept_ids": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "text",
          "implementer_dept_ids"
        ]
      },
      "CreateInitiativeDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "project",
              "task",
              "PROJECT",
              "TASK"
            ]
          },
          "year": {
            "type": "number",
            "minimum": 2000,
            "maximum": 2200
          },
          "passport": {
            "$ref": "#/components/schemas/PassportDto"
          },
          "quarters": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Q1",
                "Q2",
                "Q3",
                "Q4"
              ]
            }
          },
          "initial_scope": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        },
        "required": [
          "kind",
          "year",
          "passport",
          "quarters"
        ]
      },
      "CreateQuarterCardDto": {
        "type": "object",
        "properties": {
          "quarter": {
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4"
            ],
            "type": "string"
          },
          "passport": {
            "$ref": "#/components/schemas/PassportDto"
          },
          "initial_scope": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        },
        "required": [
          "quarter",
          "passport"
        ]
      },
      "UpdateCardDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "number",
            "minimum": 1
          },
          "passport": {
            "$ref": "#/components/schemas/PassportDto"
          },
          "health_status": {
            "type": "string",
            "format": "uuid"
          },
          "checklist": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        },
        "required": [
          "revision"
        ]
      },
      "PeriodCommandDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "number",
            "minimum": 1
          },
          "to_year": {
            "type": "number",
            "minimum": 2000,
            "maximum": 2200
          },
          "to_quarter": {
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confirmation_token": {
            "type": "string"
          }
        },
        "required": [
          "revision",
          "to_year",
          "to_quarter"
        ]
      },
      "RevisionTargetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "revision"
        ]
      },
      "SourceCardPatchDto": {
        "type": "object",
        "properties": {
          "health_status": {
            "type": "string",
            "format": "uuid"
          },
          "checklist": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        }
      },
      "SavePassportDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "number",
            "minimum": 1
          },
          "passport": {
            "$ref": "#/components/schemas/PassportDto"
          },
          "target_years": {
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevisionTargetDto"
            }
          },
          "target_cards": {
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevisionTargetDto"
            }
          },
          "source_card_patch": {
            "description": "Changes to the source card that must commit atomically with passport propagation.",
            "allOf": [
              {
                "$ref": "#/components/schemas/SourceCardPatchDto"
              }
            ]
          }
        },
        "required": [
          "revision",
          "passport",
          "target_years",
          "target_cards"
        ]
      },
      "ExtendYearsDto": {
        "type": "object",
        "properties": {
          "source_year_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "target_year": {
            "type": "number",
            "minimum": 2000,
            "maximum": 2200
          }
        },
        "required": [
          "source_year_ids",
          "target_year"
        ]
      },
      "UpdatePreparationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "strategic_goal": {
            "type": "string"
          },
          "manager_id": {
            "type": "string",
            "format": "uuid"
          },
          "priority": {
            "type": "string",
            "format": "uuid"
          },
          "notes": {
            "type": "string"
          },
          "implementer_dept_ids": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "cross_functional_dept_ids": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "custom_fields": {
            "type": "object",
            "additionalProperties": true
          },
          "revision": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "implementer_dept_ids",
          "cross_functional_dept_ids",
          "revision"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "USER"
            ]
          },
          "department_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "USER"
            ]
          },
          "department_id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "UpdatePermissionDto": {
        "type": "object",
        "properties": {
          "canCreateEditProjects": {
            "type": "boolean"
          },
          "canDeleteProjects": {
            "type": "boolean"
          },
          "canAccessAdmin": {
            "type": "boolean"
          },
          "isReadOnly": {
            "type": "boolean"
          },
          "canEditArchive": {
            "type": "boolean"
          }
        }
      },
      "DictionaryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "capacity_limit_points": {
            "type": "number",
            "minimum": 0
          },
          "department_id": {
            "type": "string",
            "format": "uuid"
          },
          "color": {
            "type": "string",
            "pattern": "^#?([0-9A-F]{3}|[0-9A-F]{4}|[0-9A-F]{6}|[0-9A-F]{8})$"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "min_score": {
            "type": "number",
            "minimum": 0
          },
          "max_score": {
            "type": "number",
            "minimum": 0
          },
          "is_active": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "CustomFieldDto": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string",
            "enum": [
              "project",
              "task"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "TEXT",
              "NUMBER",
              "SELECT",
              "CHECKBOX",
              "RICHTEXT"
            ]
          },
          "isRequired": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "showInTable": {
            "type": "boolean"
          },
          "showInCards": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "entityType",
          "name",
          "type",
          "isRequired"
        ]
      },
      "BackupImportRequestDto": {
        "type": "object",
        "properties": {
          "backup": {
            "type": "object",
            "additionalProperties": true
          },
          "validation_token": {
            "type": "string"
          }
        },
        "required": [
          "backup",
          "validation_token"
        ]
      }
    }
  }
}