generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Role {
  code           String          @id @db.VarChar(32)
  name           String          @db.NVarChar(100)
  isSystem       Boolean         @default(false) @map("is_system")
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime2
  users          User[]
  rolePermission RolePermission?

  @@unique([name], map: "UX_roles_name")
  @@map("roles")
}

model User {
  id                 String         @id @default(uuid()) @db.UniqueIdentifier
  name               String         @db.NVarChar(200)
  email              String         @db.NVarChar(320)
  normalizedEmail    String         @unique(map: "UX_users_normalized_email") @map("normalized_email") @db.NVarChar(320)
  passwordHash       String?        @map("password_hash") @db.NVarChar(500)
  role               String         @db.VarChar(32)
  departmentId       String?        @map("department_id") @db.UniqueIdentifier
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  createdAt          DateTime       @default(now()) @map("created_at") @db.DateTime2
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.DateTime2
  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleDefinition     Role           @relation(fields: [role], references: [code], onDelete: NoAction, onUpdate: NoAction)
  refreshTokens      RefreshToken[]
  auditEvents        AuditEvent[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  familyId  String    @map("family_id") @db.UniqueIdentifier
  tokenHash String    @unique(map: "UX_refresh_tokens_hash") @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.DateTime2
  revokedAt DateTime? @map("revoked_at") @db.DateTime2
  replacedBy String?  @map("replaced_by") @db.UniqueIdentifier
  userAgent  String?  @map("user_agent") @db.NVarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime2
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "IX_refresh_tokens_user_id")
  @@index([familyId], map: "IX_refresh_tokens_family_id")
  @@map("refresh_tokens")
}

model RolePermission {
  role                  String  @id @db.VarChar(32)
  canCreateEditInitiatives Boolean @default(false) @map("can_create_edit_initiatives")
  canDeleteInitiatives     Boolean @default(false) @map("can_delete_initiatives")
  canAccessAdmin        Boolean @default(false) @map("can_access_admin")
  isReadOnly            Boolean @default(false) @map("is_read_only")
  canEditArchive        Boolean @default(false) @map("can_edit_archive")
  roleDefinition        Role    @relation(fields: [role], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@map("role_permissions")
}

model Department {
  id                 String                       @id @default(uuid()) @db.UniqueIdentifier
  name               String                       @db.NVarChar(200)
  normalizedName     String                       @unique(map: "UX_departments_normalized_name") @map("normalized_name") @db.NVarChar(200)
  capacityLimitPoints Decimal                      @default(0) @map("capacity_limit_points") @db.Decimal(12, 2)
  isActive           Boolean                      @default(true) @map("is_active")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.DateTime2
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.DateTime2
  users              User[]
  managers           Manager[]
  preparationLinks   PreparationStageDepartment[]
  cardLinks          QuarterCardDepartment[]
  scopeExecutorLinks ScopeItemExecutor[]

  @@map("departments")
}

model Manager {
  id                String             @id @default(uuid()) @db.UniqueIdentifier
  name              String             @db.NVarChar(200)
  normalizedName    String             @unique(map: "UX_managers_normalized_name") @map("normalized_name") @db.NVarChar(200)
  departmentId      String?            @map("department_id") @db.UniqueIdentifier
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime2
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime2
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preparationStages PreparationStage[]
  quarterCards      QuarterCard[]

  @@map("managers")
}

model Priority {
  id                String             @id @default(uuid()) @db.UniqueIdentifier
  name              String             @db.NVarChar(100)
  normalizedName    String             @unique(map: "UX_priorities_normalized_name") @map("normalized_name") @db.NVarChar(100)
  color             String?            @db.VarChar(7)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime2
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime2
  preparationStages PreparationStage[]
  quarterCards      QuarterCard[]

  @@map("priorities")
}

model InitiativeStatus {
  id             String        @id @default(uuid()) @db.UniqueIdentifier
  code           String        @unique(map: "UX_card_status_definitions_code") @db.VarChar(32)
  name           String        @db.NVarChar(100)
  normalizedName String        @unique(map: "UX_card_status_definitions_normalized_name") @map("normalized_name") @db.NVarChar(100)
  color          String        @db.VarChar(20)
  isActive       Boolean       @default(true) @map("is_active")
  isSystem       Boolean       @default(false) @map("is_system")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime2
  quarterCards   QuarterCard[]

  @@map("card_status_definitions")
}

model TaskWeight {
  id             String      @id @default(uuid()) @db.UniqueIdentifier
  name           String      @db.NVarChar(100)
  normalizedName String      @unique(map: "UX_task_weight_definitions_normalized_name") @map("normalized_name") @db.NVarChar(100)
  weight         Decimal     @db.Decimal(12, 2)
  isDefault      Boolean     @default(false) @map("is_default")
  isSystem       Boolean     @default(false) @map("is_system")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime2
  scopeItems     ScopeItem[]

  @@map("task_weight_definitions")
}

model InitiativeSize {
  id             String        @id @default(uuid()) @db.UniqueIdentifier
  name           String        @db.NVarChar(100)
  normalizedName String        @unique(map: "UX_initiative_size_definitions_normalized_name") @map("normalized_name") @db.NVarChar(100)
  minScore       Decimal       @map("min_score") @db.Decimal(12, 2)
  maxScore       Decimal       @map("max_score") @db.Decimal(12, 2)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime2
  quarterCards   QuarterCard[]

  @@map("initiative_size_definitions")
}

model CustomFieldDefinition {
  id             String                        @id @default(uuid()) @db.UniqueIdentifier
  name           String                        @db.NVarChar(200)
  normalizedName String                        @map("normalized_name") @db.NVarChar(200)
  entityType     String                        @map("entity_type") @db.VarChar(16)
  fieldType      String                        @map("field_type") @db.VarChar(16)
  isRequired     Boolean                       @default(false) @map("is_required")
  isActive       Boolean                       @default(true) @map("is_active")
  showInTable    Boolean                       @default(false) @map("show_in_table")
  showInCards    Boolean                       @default(false) @map("show_in_cards")
  createdAt      DateTime                      @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.DateTime2
  options        CustomFieldOption[]
  values         CustomFieldValue[]

  @@unique([entityType, normalizedName], map: "UX_custom_field_definitions_entity_name")
  @@map("custom_field_definitions")
}

model CustomFieldOption {
  id           String                @id @default(uuid()) @db.UniqueIdentifier
  definitionId String                @map("definition_id") @db.UniqueIdentifier
  value        String                @db.NVarChar(500)
  sortOrder    Int                   @map("sort_order")
  isActive     Boolean               @default(true) @map("is_active")
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([definitionId, value], map: "UX_custom_field_options_definition_value")
  @@unique([definitionId, sortOrder], map: "UX_custom_field_options_definition_order")
  @@map("custom_field_options")
}

model Initiative {
  id        String           @id @default(uuid()) @db.UniqueIdentifier
  kind      String           @db.VarChar(32)
  name      String           @db.NVarChar(500)
  revision  Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime2
  updatedAt DateTime         @updatedAt @map("updated_at") @db.DateTime2
  years     InitiativeYear[]

  @@unique([kind, name], map: "UX_initiatives_kind_name")
  @@index([kind], map: "IX_initiatives_kind")
  @@map("initiatives")
}

model InitiativeYear {
  id               String            @id @default(uuid()) @db.UniqueIdentifier
  initiativeId     String            @map("initiative_id") @db.UniqueIdentifier
  year             Int
  strategicGoal    String?           @map("strategic_goal") @db.NVarChar(2000)
  revision         Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime2
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime2
  initiative       Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  preparationStage PreparationStage?
  quarterCards     QuarterCard[]

  @@unique([initiativeId, year], map: "UX_initiative_years_initiative_year")
  @@index([year], map: "IX_initiative_years_year")
  @@map("initiative_years")
}

model PreparationStage {
  initiativeYearId String                       @id @map("initiative_year_id") @db.UniqueIdentifier
  managerId        String?                      @map("manager_id") @db.UniqueIdentifier
  priorityId       String?                      @map("priority_id") @db.UniqueIdentifier
  revision         Int                          @default(1)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.DateTime2
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.DateTime2
  initiativeYear   InitiativeYear               @relation(fields: [initiativeYearId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager          Manager?                     @relation(fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priority         Priority?                    @relation(fields: [priorityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments      PreparationStageDepartment[]

  @@map("preparation_stages")
}

model PreparationStageDepartment {
  initiativeYearId String           @map("initiative_year_id") @db.UniqueIdentifier
  departmentId     String           @map("department_id") @db.UniqueIdentifier
  preparationStage PreparationStage @relation(fields: [initiativeYearId], references: [initiativeYearId], onDelete: Cascade, onUpdate: NoAction)
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([initiativeYearId, departmentId])
  @@map("preparation_stage_departments")
}

model QuarterCard {
  id                String                        @id @default(uuid()) @db.UniqueIdentifier
  initiativeYearId  String                        @map("initiative_year_id") @db.UniqueIdentifier
  quarter           Int
  managerId         String?                       @map("manager_id") @db.UniqueIdentifier
  priorityId        String?                       @map("priority_id") @db.UniqueIdentifier
  notes             String?                       @db.NVarChar(Max)
  statusId          String                        @map("status_id") @db.UniqueIdentifier
  totalWeight       Decimal                       @default(0) @map("total_weight") @db.Decimal(12, 2)
  sizeDefinitionId  String?                       @map("size_definition_id") @db.UniqueIdentifier
  sizeSnapshotName  String?                       @map("size_snapshot_name") @db.NVarChar(100)
  sizeSnapshotMin   Decimal?                      @map("size_snapshot_min") @db.Decimal(12, 2)
  sizeSnapshotMax   Decimal?                      @map("size_snapshot_max") @db.Decimal(12, 2)
  movedFromYear     Int?                          @map("moved_from_year")
  movedFromQuarter  Int?                          @map("moved_from_quarter")
  revision          Int                           @default(1)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.DateTime2
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.DateTime2
  initiativeYear    InitiativeYear                @relation(fields: [initiativeYearId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager           Manager?                      @relation(fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priority          Priority?                     @relation(fields: [priorityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status            InitiativeStatus              @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sizeDefinition    InitiativeSize?               @relation(fields: [sizeDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments       QuarterCardDepartment[]
  customFieldValues CustomFieldValue[]
  scopeItems        ScopeItem[]                    @relation("CardScopeItems")
  movedScopeItems   ScopeItem[]                    @relation("MovedFromCard")

  @@unique([initiativeYearId, quarter], map: "UX_quarter_cards_year_quarter")
  @@index([quarter], map: "IX_quarter_cards_quarter")
  @@map("quarter_cards")
}

model QuarterCardDepartment {
  quarterCardId String      @map("quarter_card_id") @db.UniqueIdentifier
  departmentId  String      @map("department_id") @db.UniqueIdentifier
  quarterCard   QuarterCard @relation(fields: [quarterCardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([quarterCardId, departmentId])
  @@map("quarter_card_departments")
}

model ScopeItem {
  id                  String              @id @default(uuid()) @db.UniqueIdentifier
  quarterCardId       String              @map("quarter_card_id") @db.UniqueIdentifier
  lineageId           String              @map("lineage_id") @db.UniqueIdentifier
  copiedFromItemId    String?             @map("copied_from_item_id") @db.UniqueIdentifier
  text                String              @db.NVarChar(2000)
  statusCode          String              @default("DEFAULT") @map("status_code") @db.VarChar(16)
  weightDefinitionId  String              @map("weight_definition_id") @db.UniqueIdentifier
  weightSnapshotName  String              @map("weight_snapshot_name") @db.NVarChar(100)
  weightSnapshotValue Decimal             @map("weight_snapshot_value") @db.Decimal(12, 2)
  movedFromCardId     String?             @map("moved_from_card_id") @db.UniqueIdentifier
  revision            Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.DateTime2
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.DateTime2
  quarterCard         QuarterCard         @relation("CardScopeItems", fields: [quarterCardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  copiedFromItem      ScopeItem?           @relation("ScopeItemCopies", fields: [copiedFromItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  copies              ScopeItem[]          @relation("ScopeItemCopies")
  weightDefinition    TaskWeight           @relation(fields: [weightDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movedFromCard       QuarterCard?         @relation("MovedFromCard", fields: [movedFromCardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executors           ScopeItemExecutor[]

  @@unique([quarterCardId, lineageId], map: "UX_scope_items_card_lineage")
  @@index([lineageId], map: "IX_scope_items_lineage")
  @@map("scope_items")
}

model ScopeItemExecutor {
  scopeItemId  String     @map("scope_item_id") @db.UniqueIdentifier
  departmentId String     @map("department_id") @db.UniqueIdentifier
  scopeItem    ScopeItem  @relation(fields: [scopeItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([scopeItemId, departmentId])
  @@map("scope_item_executors")
}

model CustomFieldValue {
  quarterCardId String                @map("quarter_card_id") @db.UniqueIdentifier
  definitionId  String                @map("definition_id") @db.UniqueIdentifier
  textValue     String?               @map("text_value") @db.NVarChar(Max)
  numberValue   Decimal?              @map("number_value") @db.Decimal(18, 4)
  booleanValue  Boolean?              @map("boolean_value")
  dateValue     DateTime?             @map("date_value") @db.Date
  optionValue   String?               @map("option_value") @db.NVarChar(200)
  quarterCard   QuarterCard           @relation(fields: [quarterCardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  definition    CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([quarterCardId, definitionId])
  @@map("quarter_card_custom_field_values")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  aggregateType String   @map("aggregate_type") @db.VarChar(100)
  aggregateId   String   @map("aggregate_id") @db.NVarChar(100)
  actionCode    String   @map("action_code") @db.VarChar(100)
  message       String   @db.NVarChar(1000)
  actorUserId   String?  @map("actor_user_id") @db.UniqueIdentifier
  actorName     String   @map("actor_name") @db.NVarChar(200)
  sourceYear    Int?     @map("source_year")
  sourceQuarter String?  @map("source_quarter") @db.Char(2)
  targetYear    Int?     @map("target_year")
  targetQuarter String?  @map("target_quarter") @db.Char(2)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.DateTime2
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([aggregateType, aggregateId, occurredAt], map: "IX_audit_events_aggregate")
  @@map("audit_events")
}
