generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id                 String              @id @default(uuid()) @db.UniqueIdentifier
  name               String              @db.NVarChar(200)
  email              String              @db.NVarChar(320)
  normalizedEmail    String              @unique(map: "UX_users_normalized_email") @map("normalized_email") @db.NVarChar(320)
  passwordHash       String?             @map("password_hash") @db.NVarChar(500)
  role               String              @db.VarChar(32)
  departmentId       String?             @map("department_id") @db.UniqueIdentifier
  isActive           Boolean             @default(true) @map("is_active")
  mustChangePassword Boolean             @default(false) @map("must_change_password")
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime2
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime2
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refreshTokens      RefreshToken[]
  checklistLinks     ChecklistAssignee[]
  auditEvents        AuditEvent[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  userId     String    @map("user_id") @db.UniqueIdentifier
  tokenHash  String    @unique(map: "UX_refresh_tokens_hash") @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.DateTime2
  revokedAt  DateTime? @map("revoked_at") @db.DateTime2
  replacedBy String?   @map("replaced_by") @db.UniqueIdentifier
  userAgent  String?   @map("user_agent") @db.NVarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime2
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt], map: "IX_refresh_tokens_user_expiry")
  @@map("refresh_tokens")
}

model RolePermission {
  role                  String  @id @db.VarChar(32)
  canCreateEditProjects Boolean @map("can_create_edit_projects")
  canDeleteProjects     Boolean @map("can_delete_projects")
  canAccessAdmin        Boolean @map("can_access_admin")
  isReadOnly            Boolean @map("is_read_only")
  canEditArchive        Boolean @map("can_edit_archive")

  @@map("role_permissions")
}

model Department {
  id                  String                @id @default(uuid()) @db.UniqueIdentifier
  name                String                @db.NVarChar(200)
  normalizedName      String                @unique(map: "UX_departments_normalized_name") @map("normalized_name") @db.NVarChar(200)
  capacityLimitPoints Decimal               @map("capacity_limit_points") @db.Decimal(12, 2)
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime2
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.DateTime2
  users               User[]
  managers            Manager[]
  passportLinks       PassportDepartment[]
  checklistLinks      ChecklistDepartment[]

  @@map("departments")
}

model Manager {
  id             String      @id @default(uuid()) @db.UniqueIdentifier
  name           String      @db.NVarChar(200)
  normalizedName String      @unique(map: "UX_managers_normalized_name") @map("normalized_name") @db.NVarChar(200)
  departmentId   String?     @map("department_id") @db.UniqueIdentifier
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime2
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passports      Passport[]

  @@map("managers")
}

model Priority {
  id             String     @id @default(uuid()) @db.UniqueIdentifier
  name           String     @db.NVarChar(100)
  normalizedName String     @unique(map: "UX_priorities_normalized_name") @map("normalized_name") @db.NVarChar(100)
  color          String?    @db.VarChar(7)
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime2
  passports      Passport[]

  @@map("priorities")
}

model InitiativeStatus {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  code           String          @unique(map: "UX_initiative_statuses_code") @db.VarChar(64)
  name           String          @db.NVarChar(100)
  normalizedName String          @unique(map: "UX_initiative_statuses_normalized_name") @map("normalized_name") @db.NVarChar(100)
  color          String          @db.VarChar(7)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime2
  cards          QuarterCard[]
  checklistItems ChecklistItem[]

  @@map("initiative_statuses")
}

model TaskWeight {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  name           String          @db.NVarChar(100)
  normalizedName String          @unique(map: "UX_task_weights_normalized_name") @map("normalized_name") @db.NVarChar(100)
  weight         Decimal         @db.Decimal(12, 2)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime2
  checklistItems ChecklistItem[]

  @@map("task_weights")
}

model InitiativeSize {
  id             String        @id @default(uuid()) @db.UniqueIdentifier
  name           String        @db.NVarChar(100)
  normalizedName String        @unique(map: "UX_initiative_sizes_normalized_name") @map("normalized_name") @db.NVarChar(100)
  minScore       Decimal       @map("min_score") @db.Decimal(12, 2)
  maxScore       Decimal       @map("max_score") @db.Decimal(12, 2)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime2
  cards          QuarterCard[]

  @@map("initiative_sizes")
}

model CustomFieldDefinition {
  id             String              @id @default(uuid()) @db.UniqueIdentifier
  entityType     String              @map("entity_type") @db.VarChar(16)
  name           String              @db.NVarChar(200)
  normalizedName String              @map("normalized_name") @db.NVarChar(200)
  fieldType      String              @map("field_type") @db.VarChar(16)
  isRequired     Boolean             @default(false) @map("is_required")
  showInTable    Boolean             @default(false) @map("show_in_table")
  showInCards    Boolean             @default(false) @map("show_in_cards")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime2
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime2
  options        CustomFieldOption[]
  values         CustomFieldValue[]

  @@unique([entityType, normalizedName], map: "UX_custom_fields_entity_name")
  @@map("custom_field_definitions")
}

model CustomFieldOption {
  id           String                @id @default(uuid()) @db.UniqueIdentifier
  definitionId String                @map("definition_id") @db.UniqueIdentifier
  value        String                @db.NVarChar(500)
  sortOrder    Int                   @map("sort_order")
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([definitionId, value], map: "UX_custom_field_options_value")
  @@unique([definitionId, sortOrder], map: "UX_custom_field_options_order")
  @@map("custom_field_options")
}

model Initiative {
  id        String           @id @default(uuid()) @db.UniqueIdentifier
  kind      String           @db.VarChar(16)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime2
  updatedAt DateTime         @updatedAt @map("updated_at") @db.DateTime2
  years     InitiativeYear[]

  @@map("initiatives")
}

model Passport {
  id               String               @id @default(uuid()) @db.UniqueIdentifier
  name             String               @db.NVarChar(300)
  strategicGoal    String?              @map("strategic_goal") @db.NVarChar(Max)
  managerId        String?              @map("manager_id") @db.UniqueIdentifier
  priorityId       String?              @map("priority_id") @db.UniqueIdentifier
  notes            String?              @db.NVarChar(Max)
  createdAt        DateTime             @default(now()) @map("created_at") @db.DateTime2
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.DateTime2
  manager          Manager?             @relation(fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priority         Priority?            @relation(fields: [priorityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments      PassportDepartment[]
  customValues     CustomFieldValue[]
  annualOwner      InitiativeYear?      @relation("AnnualPassport")
  preparationOwner InitiativeYear?      @relation("PreparationPassport")
  cardOwner        QuarterCard?

  @@map("passports")
}

model PassportDepartment {
  passportId   String     @map("passport_id") @db.UniqueIdentifier
  departmentId String     @map("department_id") @db.UniqueIdentifier
  involvement  String     @db.VarChar(32)
  passport     Passport   @relation(fields: [passportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([passportId, departmentId, involvement])
  @@index([departmentId], map: "IX_passport_departments_department")
  @@map("passport_departments")
}

model CustomFieldValue {
  id           String                @id @default(uuid()) @db.UniqueIdentifier
  definitionId String                @map("definition_id") @db.UniqueIdentifier
  passportId   String                @map("passport_id") @db.UniqueIdentifier
  textValue    String?               @map("text_value") @db.NVarChar(Max)
  numberValue  Decimal?              @map("number_value") @db.Decimal(32, 8)
  booleanValue Boolean?              @map("boolean_value")
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passport     Passport              @relation(fields: [passportId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([definitionId, passportId], map: "UX_custom_field_values_owner")
  @@map("custom_field_values")
}

model InitiativeYear {
  id                    String        @id @default(uuid()) @db.UniqueIdentifier
  initiativeId          String        @map("initiative_id") @db.UniqueIdentifier
  year                  Int
  annualPassportId      String        @unique(map: "UX_initiative_years_annual_passport") @map("annual_passport_id") @db.UniqueIdentifier
  preparationPassportId String        @unique(map: "UX_initiative_years_preparation_passport") @map("preparation_passport_id") @db.UniqueIdentifier
  revision              Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at") @db.DateTime2
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.DateTime2
  initiative            Initiative    @relation(fields: [initiativeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  annualPassport        Passport      @relation("AnnualPassport", fields: [annualPassportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preparationPassport   Passport      @relation("PreparationPassport", fields: [preparationPassportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cards                 QuarterCard[]

  @@unique([initiativeId, year], map: "UX_initiative_years_initiative_year")
  @@index([year], map: "IX_initiative_years_year")
  @@map("initiative_years")
}

model QuarterCard {
  id                 String            @id @default(uuid()) @db.UniqueIdentifier
  initiativeYearId   String            @map("initiative_year_id") @db.UniqueIdentifier
  passportId         String            @unique(map: "UX_quarter_cards_passport") @map("passport_id") @db.UniqueIdentifier
  quarter            String            @db.Char(2)
  statusId           String?           @map("status_id") @db.UniqueIdentifier
  sizeDefinitionId   String?           @map("size_definition_id") @db.UniqueIdentifier
  sizeSnapshotName   String            @map("size_snapshot_name") @db.NVarChar(100)
  sizeSnapshotWeight Decimal           @map("size_snapshot_weight") @db.Decimal(12, 2)
  movedFromYear      Int?              @map("moved_from_year")
  movedFromQuarter   String?           @map("moved_from_quarter") @db.Char(2)
  revision           Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime2
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime2
  initiativeYear     InitiativeYear    @relation(fields: [initiativeYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passport           Passport          @relation(fields: [passportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status             InitiativeStatus? @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sizeDefinition     InitiativeSize?   @relation(fields: [sizeDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checklistItems     ChecklistItem[]

  @@unique([initiativeYearId, quarter], map: "UX_quarter_cards_year_quarter")
  @@index([quarter], map: "IX_quarter_cards_quarter")
  @@map("quarter_cards")
}

model ChecklistItem {
  id                  String                @id @default(uuid()) @db.UniqueIdentifier
  cardId              String                @map("card_id") @db.UniqueIdentifier
  text                String                @db.NVarChar(1000)
  isCompleted         Boolean               @default(false) @map("is_completed")
  statusId            String?               @map("status_id") @db.UniqueIdentifier
  weightDefinitionId  String?               @map("weight_definition_id") @db.UniqueIdentifier
  weightSnapshotName  String                @map("weight_snapshot_name") @db.NVarChar(100)
  weightSnapshotValue Decimal               @map("weight_snapshot_value") @db.Decimal(12, 2)
  movedFromYear       Int?                  @map("moved_from_year")
  movedFromQuarter    String?               @map("moved_from_quarter") @db.Char(2)
  revision            Int                   @default(1)
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime2
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.DateTime2
  card                QuarterCard           @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status              InitiativeStatus?     @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  weightDefinition    TaskWeight?           @relation(fields: [weightDefinitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  departments         ChecklistDepartment[]
  assignees           ChecklistAssignee[]

  @@index([cardId], map: "IX_checklist_items_card")
  @@map("checklist_items")
}

model ChecklistDepartment {
  checklistItemId String        @map("checklist_item_id") @db.UniqueIdentifier
  departmentId    String        @map("department_id") @db.UniqueIdentifier
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([checklistItemId, departmentId])
  @@index([departmentId], map: "IX_checklist_departments_department")
  @@map("checklist_item_departments")
}

model ChecklistAssignee {
  checklistItemId String        @map("checklist_item_id") @db.UniqueIdentifier
  userId          String        @map("user_id") @db.UniqueIdentifier
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user            User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([checklistItemId, userId])
  @@index([userId], map: "IX_checklist_assignees_user")
  @@map("checklist_item_assignees")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  aggregateType String   @map("aggregate_type") @db.VarChar(40)
  aggregateId   String   @map("aggregate_id") @db.UniqueIdentifier
  actionCode    String   @map("action_code") @db.VarChar(80)
  message       String   @db.NVarChar(1000)
  actorUserId   String?  @map("actor_user_id") @db.UniqueIdentifier
  actorName     String   @map("actor_name") @db.NVarChar(200)
  sourceYear    Int?     @map("source_year")
  sourceQuarter String?  @map("source_quarter") @db.Char(2)
  targetYear    Int?     @map("target_year")
  targetQuarter String?  @map("target_quarter") @db.Char(2)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.DateTime2
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aggregateType, aggregateId, occurredAt], map: "IX_audit_events_aggregate")
  @@map("audit_events")
}
